#
# 环境：开发环境（develop）
# 使用说明：将本文件复制为 .env.local 以启用开发环境配置
#

# 应用运行环境标识（develop/beta/uat）
NEXT_PUBLIC_APP_ENV=develop

# 后端 API 基础地址
NEXT_PUBLIC_API_URL=http://develop.ark-core-api.abt:30080

# WebSocket 服务地址
NEXT_PUBLIC_SOCKET_URL=ws://develop.ark-core-wss.abt:30080/ws-api/v1

# 应用访问密钥（公开值，不用于服务端敏感认证）
NEXT_PUBLIC_APP_ACCESS_KEY=BnOdCe6rMM3QXy3u9MalIcX7ocwzogQBACZfPuGu

# 应用末端密钥（公开值，不用于服务端敏感认证）
NEXT_PUBLIC_APP_END_KEY=Qlz2rbxAF7XpMHKj2QAtLcUftFU1FWIWvltKrIjr

# 应用日志路径名
NEXT_PUBLIC_APP_LOG_PATH_NAME=ark_development

# 二维码解密密钥（用于本地解码逻辑）
NEXT_PUBLIC_QR_CODE_DECRYPT_KEY=WF6Xbcr3v0O8E3qK

# 资源存储桶名称（公共读取）
NEXT_PUBLIC_ASSETS_MINIO_BUCKET_NAME=oss-hive-public

# 资源上传存储桶名称（上传用）
NEXT_PUBLIC_ASSETS_MINIO_UPLOAD_BUCKET_NAME=oss-ark-base

# 应用 ID
NEXT_PUBLIC_APP_ID=319220

# OSS 基础访问地址
